# Default (non-secret) settings. Override locally in `.env.local`,
# or set the same names in Vercel/Netlify -> Project Settings -> Environment Variables.

# Shown in the hero text and page title, e.g. "Find AIUB faculty"
VITE_UNIVERSITY_NAME=AIUB

# Optional: shows a GitHub link in the header/footer when set
VITE_GITHUB_URL=

# Optional: where the CSV lives. Default is the file in /public.
VITE_CSV_URL=/faculty.json
